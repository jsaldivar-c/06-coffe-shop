  "narrative": {
    "northStar": "The Night Roastery",
    "overview": "A dark room lit by the glow of the roaster. Everything sits on a deep espresso canvas; caramel is the single warm light that tells you where to act. Headlines are set in a high-contrast display serif, with a handwritten script accent (Reenie Beanie) used sparingly like a note scribbled on a bag. The mood is intimate, hand-made and unhurried, not clinical or startup-slick.",
    "keyCharacteristics": [
      "Dark-first: espresso page, roast cards, bronze for bands and borders.",
      "One accent (caramel) for actions, prices and selected states.",
      "Serif display + friendly sans body + occasional script flourish.",
      "Soft 8–12px corners, solid fills, gentle hover lift."
    ],
    "rules": [
      {
        "name": "The One Flame Rule",
        "body": "Caramel is the only accent. If two things on a screen glow caramel, one of them is wrong; it marks the action, the price, or the selection.",
        "section": "colors"
      },
      {
        "name": "The Tinted Dark Rule",
        "body": "No pure black or pure white. Darks are brown-tinted (espresso, roast); lights are warm (ivory, cream).",
        "section": "colors"
      },
      {
        "name": "The Logo Script Rule",
        "body": "Reenie Beanie is reserved for the logo suffix. No eyebrows above headings, never body copy or buttons.",
        "section": "typography"
      },
      {
        "name": "The Tonal Step Rule",
        "body": "Separate surfaces by shifting one step in the brown ramp before reaching for a shadow or border.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the page espresso and raise surfaces to roast, then bronze.",
      "Do reserve caramel for actions, prices and selection.",
      "Do use Young Serif for headings and product names, Hanken Grotesk for everything functional.",
      "Do keep touch targets at 44px or more (buttons 52px).",
      "Do use `px-gutter` for horizontal page padding."
    ],
    "donts": [
      "Don't use pure black or pure white; stay with the brown-tinted ramp.",
      "Don't add a second accent color alongside caramel (olive is for success only).",
      "Don't use Reenie Beanie beyond the logo suffix, and never put an eyebrow above a heading.",
      "Don't stack heavy shadows or glass effects; the system is tonal.",
      "Don't present the placeholder packaging or demo content as final product imagery."
    ]
  }
}