<section class="px-gutter flex flex-wrap items-center justify-between gap-7 bg-bronze py-16">
  <div class="max-w-[480px]">
    <h2 class="mb-2 font-serif text-[clamp(28px,3.5vw,40px)] font-normal">10% en tu primera compra</h2>
    <p class="text-base">Déjanos tu correo y te mandamos el cupón.</p>
  </div>
  <form class="flex min-w-[260px] max-w-[480px] flex-1 flex-wrap gap-2.5" onsubmit="event.preventDefault()">
    <input type="email" required placeholder="tu@correo.com" aria-label="Correo electrónico" class="min-h-[52px] min-w-[180px] flex-1 rounded-lg border border-bronze bg-espresso px-4 py-3.5 text-ivory outline-none focus:border-caramel" />
    <button type="submit" class="btn-primary min-h-[52px] px-6 py-3.5">Quiero mi cupón</button>
  </form>
</section>
