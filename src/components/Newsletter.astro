<section class="px-gutter flex flex-wrap items-center justify-between gap-7 bg-caramel py-16 text-espresso">
  <div class="max-w-[480px]">
    <h2 class="mb-2 text-[clamp(28px,3.5vw,40px)] leading-[1.1]">10% en tu primera compra</h2>
    <p class="text-base">Déjanos tu correo y te mandamos el cupón.</p>
  </div>
  <form class="flex min-w-[260px] max-w-[480px] flex-1 flex-wrap gap-2.5" onsubmit="event.preventDefault()">
    <input type="email" required placeholder="tu@correo.com" aria-label="Correo electrónico" class="min-h-[52px] min-w-[180px] flex-1 rounded-lg border border-espresso/40 bg-espresso px-4 py-3.5 text-ivory outline-none focus:border-ivory" />
    <button type="submit" class="min-h-[52px] cursor-pointer rounded-lg bg-espresso px-6 py-3.5 font-bold text-ivory transition-colors hover:bg-roast">Quiero mi cupón</button>
  </form>
</section>
