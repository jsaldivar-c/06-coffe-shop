---
import { REVIEWS } from '../config/site';
---

<section class="px-gutter py-20">
  <h2 class="mb-9 text-[clamp(32px,4vw,48px)] leading-[1.1]">Lo que dicen en casa</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-5">
    {REVIEWS.map((r) => (
      <figure class="flex flex-col rounded-xl bg-roast p-7">
        <div class="mb-4 flex gap-1 text-caramel" role="img" aria-label="5 estrellas"><svg viewBox="0 0 20 20" class="size-4 fill-current" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/></svg><svg viewBox="0 0 20 20" class="size-4 fill-current" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/></svg><svg viewBox="0 0 20 20" class="size-4 fill-current" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/></svg><svg viewBox="0 0 20 20" class="size-4 fill-current" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/></svg><svg viewBox="0 0 20 20" class="size-4 fill-current" aria-hidden="true"><path d="M10 1.5l2.6 5.6 6.1.7-4.5 4.2 1.2 6L10 15l-5.4 3 1.2-6L1.3 7.8l6.1-.7z"/></svg></div>
        <blockquote class="mb-6 flex-1 text-[17px] leading-[1.55] text-pretty">“{r.quote}”</blockquote>
        <figcaption class="text-sm text-cream">{r.author}</figcaption>
      </figure>
    ))}
  </div>
</section>
